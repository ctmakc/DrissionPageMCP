# auto | immich | google_web
PHOTO_PROVIDER=auto

# Optional static bearer token for the MCP endpoint.
# Leave empty when the server is reachable only through a trusted private tunnel.
MCP_BEARER_TOKEN=
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Immich adapter
IMMICH_URL=http://127.0.0.1:2283
IMMICH_API_KEY=
IMMICH_REQUEST_TIMEOUT=30

# Direct Google Photos browser adapter
GOOGLE_PHOTOS_DEBUG_PORT=9222
GOOGLE_PHOTOS_BROWSER_PATH=
GOOGLE_PHOTOS_HEADLESS=false
GOOGLE_PHOTOS_CACHE_DIR=./.cache/google-photos-bridge
GOOGLE_PHOTOS_SCROLL_ROUNDS=12
GOOGLE_PHOTOS_WAIT_SECONDS=3
